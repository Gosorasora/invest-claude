# invest-claude 환경 변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 커밋되지 않습니다)

# --- LLM (선택) ---
# Anthropic API 키. 설정하고 anthropic 패키지를 설치하면 실제 Claude 로 토론합니다.
# 비워두면 결정론적 MockLLM 으로 동작합니다(오프라인).
ANTHROPIC_API_KEY=

# LLM 모드: auto | mock | anthropic  (기본 auto)
# auto: 키+패키지가 있으면 실제 LLM, 아니면 mock
INVEST_LLM=auto

# 사용할 Claude 모델 ID (선택, 기본 claude-opus-4-8)
INVEST_MODEL=claude-opus-4-8

# --- KIS(한국투자증권) Open API 실거래용 (추후 구현) ---
# 토스증권은 공개 자동매매 API 가 없으므로, 실거래는 KIS Open API 를 사용합니다.
# 아래 값을 채워도 현재 버전은 아직 mock/paper 로 동작합니다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
